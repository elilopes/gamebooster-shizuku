    <string name="boost_thermal_title">禁用温控限制</string>
    <string name="boost_thermal_desc">禁用发热降频，防止设备变热时系统降低 CPU/GPU 频率。</string>
    <string name="boost_overlay_title">停用硬件叠加层</string>
    <string name="boost_overlay_desc">停用硬件叠加层，让游戏能够直接使用 GPU 渲染。</string>
    <string name="boost_cache_title">自动清理缓存</string>
    <string name="boost_cache_desc">在启动游戏前自动清除游戏缓存目录，保持运行环境清爽。</string>
    <string name="boost_oom_title">OOM 防杀机制</string>
    <string name="boost_oom_desc">锁定游戏进程优先级，防止在后台被系统 OOM Killer 强行关闭。</string>
    <string name="boost_adblock_title">游戏广告拦截器 (Shizuku DNS)</string>
    <string name="boost_adblock_desc">使用 Shizuku Private DNS 在系统级拦截游戏中的广告网络（AdMob、Unity Ads、AppLovin 等）。</string>

