    <string name="boost_thermal_title">Thermal Limit Disable</string>
    <string name="boost_thermal_desc">Disables thermal throttling to prevent the system from reducing CPU/GPU speed when the device gets hot.</string>
    <string name="boost_overlay_title">Disable Hardware Overlays</string>
    <string name="boost_overlay_desc">Disables hardware overlays to give the game direct access to the GPU for rendering.</string>
    <string name="boost_cache_title">Auto Clear Cache</string>
    <string name="boost_cache_desc">Automatically clears the game\'s cache directory before launching to ensure a fresh start.</string>
    <string name="boost_oom_title">OOM Killer Immortal</string>
    <string name="boost_oom_desc">Sets the game process priority to be immune to the Android OOM Killer, preventing it from being closed in the background.</string>
    <string name="boost_max_cpu_title">Force Max CPU Frequency</string>
    <string name="boost_max_cpu_desc">Locks CPU cores at their absolute maximum frequency for peak gaming performance without thermal throttling limits.</string>
    <string name="boost_max_gpu_title">Force Max GPU Frequency</string>
    <string name="boost_max_gpu_desc">Locks GPU at maximum frequency to prevent frame rate (FPS) drops and stuttering.</string>
    <string name="hardware_warning_disclaimer">Disclaimer: This application is not responsible for instability, overheating, system restarts, or rapid battery drain. Use at your own risk.</string>
    <string name="boost_adblock_title">Game Ad Blocker (Shizuku DNS)</string>
    <string name="boost_adblock_desc">Blocks ad networks (Google AdMob, Unity Ads, AppLovin) system-wide using Shizuku Private DNS.</string>
    <string name="boost_adblock_realtime">Real-time Ad Monitoring</string>
    <string name="boost_animations_title">Disable Animations (0.0x)</string>
    <string name="boost_animations_desc">Sets window, transition, and animator scales to 0.0 for instant transitions and zero compositor overhead.</string>
    <string name="boost_touch_sampling_title">High Touch Sampling Rate</string>
    <string name="boost_touch_sampling_desc">Forces maximum touch response rate and gaming touch sensitivity for faster reaction in games.</string>
    <string name="boost_limit_bg_title">Limit Background Processes (Close All)</string>
    <string name="boost_limit_bg_desc">Sets background process limit to 0 and closes running background tasks to maximize CPU/RAM for games.</string>
    <string name="boost_block_autorestart_title">Block App Auto-Restart</string>
    <string name="boost_block_autorestart_desc">Revokes background execution ops (RUN_IN_BACKGROUND) preventing apps from restarting on their own.</string>
    <string name="boost_deep_sleep_title">Force Deep Sleep for Cached Apps</string>
    <string name="boost_deep_sleep_desc">Freezes and puts cached applications into deep sleep mode, dedicating resources exclusively to active gaming.</string>
    <string name="boost_deep_sleep_btn">Trigger Deep Sleep Now</string>
    <string name="boost_deep_sleep_success">Cached apps successfully suspended into Deep Sleep.</string>
