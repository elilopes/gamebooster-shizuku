    <string name="boost_thermal_title">Désactiver la limite thermique</string>
    <string name="boost_thermal_desc">Désactive la limitation thermique pour empêcher le système de réduire la vitesse du CPU/GPU lorsque l\'appareil chauffe.</string>
    <string name="boost_overlay_title">Désactiver les superpositions matérielles</string>
    <string name="boost_overlay_desc">Désactive les superpositions matérielles pour donner au jeu un accès direct au GPU pour le rendu.</string>
    <string name="boost_cache_title">Vider le cache automatiquement</string>
    <string name="boost_cache_desc">Efface automatiquement le répertoire de cache du jeu avant le lancement pour garantir un démarrage propre.</string>
    <string name="boost_oom_title">Immortel OOM Killer</string>
    <string name="boost_oom_desc">Définit la priorité du processus du jeu pour être immunisé contre l\'OOM Killer d\'Android, évitant qu\'il ne soit fermé en arrière-plan.</string>
    <string name="boost_adblock_title">Bloqueur de pubs (Shizuku DNS)</string>
    <string name="boost_adblock_desc">Bloque les réseaux publicitaires à l\'échelle du système en utilisant Shizuku Private DNS.</string>
    <string name="boost_warning_note">Remarque : certains paramètres d\'accélération peuvent faire surchauffer l\'appareil.</string>

