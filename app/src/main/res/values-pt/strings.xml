    <string name="boost_thermal_title">Desativar Limite Térmico</string>
    <string name="boost_thermal_desc">Desativa a limitação térmica para evitar que o sistema reduza a velocidade da CPU/GPU quando o dispositivo aquece.</string>
    <string name="boost_overlay_title">Desativar Overlays de Hardware</string>
    <string name="boost_overlay_desc">Desativa as sobreposições de hardware para dar ao jogo acesso direto à GPU para renderização.</string>
    <string name="boost_cache_title">Limpeza Automática de Cache</string>
    <string name="boost_cache_desc">Limpa automaticamente o diretório de cache do jogo antes de iniciar, garantindo um início limpo.</string>
    <string name="boost_oom_title">OOM Killer Imortal</string>
    <string name="boost_oom_desc">Define a prioridade do processo do jogo para ser imune ao OOM Killer do Android, evitando que ele seja fechado em segundo plano.</string>
    <string name="boost_adblock_title">Bloqueador de Propaganda (Shizuku DNS)</string>
    <string name="boost_adblock_desc">Bloqueia redes de anúncio em jogos (Google AdMob, Unity Ads, AppLovin) em nível de sistema usando Private DNS via Shizuku.</string>
