    <string name="auto_memory_release_desc">Libera memória automaticamente quando o uso ultrapassar 90%.</string>

    <string name="boost_thermal_title">Desativar Limite Térmico</string>
    <string name="boost_thermal_desc">Desativa o throttling térmico para evitar que o sistema reduza a velocidade da CPU/GPU quando o aparelho esquenta.</string>
    <string name="boost_overlay_title">Desativar Sobreposições de Hardware</string>
    <string name="boost_overlay_desc">Desativa sobreposições de hardware para conceder ao jogo acesso direto à GPU para renderização.</string>
    <string name="boost_cache_title">Limpar Cache Automaticamente</string>
    <string name="boost_cache_desc">Limpa automaticamente o diretório de cache do jogo antes de iniciar para garantir uma inicialização limpa.</string>
    <string name="boost_oom_title">Imunidade ao OOM Killer</string>
    <string name="boost_oom_desc">Define a prioridade do processo do jogo para torná-lo imune ao Android OOM Killer, evitando encerramentos em segundo plano.</string>
    <string name="boost_max_cpu_title">Forçar Frequência Máxima de CPU</string>
    <string name="boost_max_cpu_desc">Trava os núcleos da CPU na frequência máxima para obter desempenho de pico sem limitações térmicas.</string>
    <string name="boost_max_gpu_title">Forçar Frequência Máxima de GPU</string>
    <string name="boost_max_gpu_desc">Trava a GPU na frequência máxima para evitar quedas bruscas de taxa de quadros (FPS) e travamentos.</string>
    <string name="hardware_warning_disclaimer">Aviso: Este aplicativo não é responsável por instabilidades, superaquecimento, reinicializações do sistema ou consumo acelerado de bateria. Use por sua conta e risco.</string>
    <string name="boost_adblock_title">Bloqueador de Anúncios em Jogos (Shizuku DNS)</string>
    <string name="boost_adblock_desc">Bloqueia redes de anúncios (Google AdMob, Unity Ads, AppLovin) em todo o sistema usando o DNS Privado via Shizuku.</string>
    <string name="boost_adblock_realtime">Monitoramento de Anúncios em Tempo Real</string>
    <string name="boost_animations_title">Desativar Animações (0.0x)</string>
    <string name="boost_animations_desc">Define as escalas de janela, transição e animador para 0.0 para transições instantâneas e sem sobrecarga do compositor.</string>
    <string name="boost_touch_sampling_title">Taxa Elevada de Amostragem de Toque</string>
    <string name="boost_touch_sampling_desc">Força taxa máxima de resposta e sensibilidade de toque para respostas ultrarrápidas em jogos.</string>
    <string name="boost_limit_bg_title">Limitar Processos em Segundo Plano (Fechar Todos)</string>
    <string name="boost_limit_bg_desc">Define o limite de processos em segundo plano para 0 e encerra tarefas ativas para liberar CPU/RAM máxima para jogos.</string>
    <string name="boost_block_autorestart_title">Bloquear Reinício Automático de Apps</string>
    <string name="boost_block_autorestart_desc">Revoga a permissão de execução em segundo plano (RUN_IN_BACKGROUND) impedindo que os apps reiniciem sozinhos.</string>
    <string name="boost_deep_sleep_title">Forçar Suspensão Profunda (Deep Sleep) de Apps em Cache</string>
    <string name="boost_deep_sleep_desc">Congela e coloca aplicativos em cache no modo de suspensão profunda, dedicando recursos exclusivamente ao jogo ativo.</string>
    <string name="boost_deep_sleep_btn">Ativar Deep Sleep Agora</string>
    <string name="boost_deep_sleep_success">Aplicativos em cache suspensos com sucesso em Deep Sleep.</string>
    <string name="boost_warning_note">Nota: algumas configurações de aceleração podem fazer o dispositivo aquecer mais rápido.</string>

